node_modules/
.next/
out/
dist/
.superpowers/
*.log
.DS_Store
Thumbs.db

# vídeos originais: re-baixáveis, pesados. As versões web ficam versionadas.
VIDEOS/originais/

# relatórios locais do lighthouse
lh-*.json

# backups de assets locais: uteis pra comparacao na maquina, mas nao
# precisam viver no historico do git (o arquivo anterior ja fica no commit
# anterior de qualquer forma)
*.local-fallback
*.frame-video
*.claude-design-artefatos.*
# Vínculo local com a Vercel e o token OIDC que ela grava no .env.local — o
# token é credencial, nunca entra no repositório.
.vercel
.env*
# ...mas o .env.example é DOCUMENTAÇÃO (explica NEXT_PUBLIC_SITE_URL para quem
# for publicar) e precisa continuar versionado.
!.env.example
